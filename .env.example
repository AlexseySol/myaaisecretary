# Required — the only three values a deploy needs
OWNER_TELEGRAM_ID=        # your numeric Telegram ID (@userinfobot); the bot answers only this person
TELEGRAM_BOT_TOKEN=       # @BotFather
OPENROUTER_API_KEY=       # https://openrouter.ai/keys

# Optional — everything below is set in the bot itself (/start, /settings) or has a default
GOOGLE_CLIENT_JSON=       # Google OAuth client JSON; normally sent to the bot in /settings → 🔗 Google instead
BITRIX_WEBHOOK_URL=       # Bitrix24 incoming webhook; normally given in /settings → 📋 Bitrix24
ZOOM_ACCOUNT_ID=          # Zoom (Server-to-Server OAuth); normally given in /settings → 🎥 Zoom
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=       # projects/<id>/topics/<name>; normally the bot sets Gmail push up itself
AGENT_MODEL=openai/gpt-6-luna-pro     # text requests: Supervisor and the agents (tool calling)
VISION_MODEL=google/gemini-2.5-flash  # requests with pictures (screenshots, photos)
LLM_MODEL=openai/gpt-6-luna-pro       # voice requests + retry when the cheap model fails
LLM_MODEL_SUMMARY=openai/gpt-6-luna-pro
STT_MODEL=google/gemini-2.5-flash     # transcribes voice; must accept OGG audio
REMINDER_MINUTES=30,10    # default reminder marks; the owner changes them in /settings → ⏰
ENCRYPTION_KEY=           # defaults to a key derived from the bot token; changing it means reconnecting Google
TELEGRAM_WEBHOOK_SECRET=  # defaults to a secret derived from the bot token
CRON_SECRET=              # when set, only the scheduler can call /api/cron/daily
OWNER_NAME=               # for event descriptions; defaults to your Telegram name
OWNER_POSITION=
OWNER_PHONE=
DEFAULT_DURATION_MIN=60
DEFAULT_FORMAT=offline    # offline | google_meet | zoom
DEFAULT_ADDRESS=          # for offline meetings when the chat names no place
PUBLIC_URL=               # custom domain; defaults to the Vercel production URL
